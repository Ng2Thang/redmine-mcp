# External Redmine / local MCP configuration.
# Copy this template only for external-instance configuration.
# For the synthetic stack, scripts/dev-up.sh generates .env and random secrets;
# do not copy this template over its generated configuration.

# Redmine URL reachable from MCP, without credentials, query, or fragment.
# Local Python: http://localhost:3000
# Container accessing Windows host: http://host.docker.internal:3000
# The synthetic Compose override sets http://redmine:3000 inside containers.
REDMINE_URL=http://localhost:3000

# Runtime access. Base Compose always keeps mcp-server read-only.
# The separate mcp-writer profile enables writes on its own listener.
# For a local Python writer, set this true after configuring writer identity below.
REDMINE_WRITE_ENABLED=false

# Compose host ports; both listeners bind to localhost.
MCP_HOST_PORT=8000
MCP_WRITER_HOST_PORT=8001

# Writer identity: configure these in a separate ignored writer env-file.
# User IDs are comma-separated positive Redmine IDs; use an ordinary restricted user.
# KEY_SHA256 is the lowercase 64-character SHA-256 digest of its personal API key.
# Never store the raw API key here or use an administrator key for the writer.
# pinned_key preserves the single-key writer. personal_key accepts each caller's own key.
# In personal_key mode, clear the hash; user IDs are an optional write-only restriction.
REDMINE_WRITER_AUTH_MODE=pinned_key
# Both identity values are required when pinned-key writes are enabled.
REDMINE_WRITER_USER_IDS=1
REDMINE_WRITER_KEY_SHA256=1224ef525ce6a102ca9d52791f71b7d5dfbcc2661261fa70ca2d605edc36c1b6

# All 11 implemented write operations. Remove names to restrict the writer.
# An empty value allows no writes; unknown operation names prevent startup.
# Redmine project permissions still apply to every operation.
REDMINE_WRITER_OPERATIONS=upload_attachment,add_project_file,update_attachment,delete_attachment,create_issue,update_issue,update_issue_note,create_issue_relation,delete_issue_relation,add_issue_watcher,remove_issue_watcher

# Upstream timeouts (seconds), per-request deadline, payload limits (bytes),
# and shared connection-pool limits. Keepalive must not exceed max connections.
REDMINE_TIMEOUT_SECONDS=20
REDMINE_CONNECT_TIMEOUT_SECONDS=5
REDMINE_POOL_TIMEOUT_SECONDS=5
REDMINE_REQUEST_DEADLINE_SECONDS=60
REDMINE_MAX_RESPONSE_BYTES=10485760
REDMINE_MAX_BINARY_BYTES=5242880
REDMINE_MAX_CONNECTIONS=100
REDMINE_MAX_KEEPALIVE_CONNECTIONS=20
# Shared upstream admission and stateless pagination policy (per server process).
REDMINE_MAX_CONCURRENT_REQUESTS=50
REDMINE_ADMISSION_TIMEOUT_SECONDS=30
REDMINE_MAX_QUERY_PAGES=10
REDMINE_READ_OPERATION_MAX_REQUESTS=30
REDMINE_READ_OPERATION_DEADLINE_SECONDS=90
REDMINE_READ_OPERATION_MAX_BYTES=10485760
# Optional browser-reachable Redmine base URL, including any deployment subpath.
# REDMINE_PUBLIC_URL=http://localhost:3000
LOG_LEVEL=INFO

# Synthetic stack only; unused when connecting to an external Redmine instance.
# scripts/local_env.py generates these values when scripts/dev-up.sh creates .env.
# REDMINE_SECRET_KEY_BASE is also passed as SECRET_KEY_BASE inside Redmine.
# The generated marker is redmine-mcp-synthetic-v1. Leave it blank for real instances;
# the marker alone does not initialize synthetic state or authorize reset/restore.
POSTGRES_PASSWORD=replace-with-database-password
TEST_USER_PASSWORD=replace-with-test-user-password
REDMINE_SECRET_KEY_BASE=
REDMINE_TEST_MARKER=

# Per-request authentication uses X-Redmine-API-Key, not an application-wide key.
# Retired REDMINE_API_KEY and MCP_API_TOKEN must not be defined.
# Database connection names, RAILS_ENV, Git Bash path-conversion flags, and Docker
# build variables are fixed by Compose/Dockerfiles/scripts, not .env settings.

